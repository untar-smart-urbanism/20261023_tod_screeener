# Copy to .env and fill in your own values locally.
# .env is listed in .gitignore and must never be committed.

# --- Browser (bundled by Vite: anyone using the app can read these) ---
# Only keys meant to be public (e.g. a domain-restricted map-tiles key).
MAP_TILES_API_KEY=your-key-here
DATA_API_URL=/api
STUDY_AREA=district-name

# --- Server only (read by server/, never exposed to the browser) ---
API_PORT=8787
LISTINGS_API_URL=https://api.example.org/v1/listings
LISTINGS_API_KEY=your-server-side-key
# DATABASE_URL=postgres://user:password@localhost:5432/tod_screener
